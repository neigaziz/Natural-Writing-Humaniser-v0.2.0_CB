{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-skills-specialist/schemas/tool-contract.schema.json",
  "title": "Tool Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "purpose", "inputSchema", "outputSchema", "permissions", "timeoutMs", "maxAttempts", "idempotent", "failureModes", "approvalRequired"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "inputSchema": {"type": "object"},
    "outputSchema": {"type": "object"},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "timeoutMs": {"type": "integer", "minimum": 1},
    "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 3},
    "idempotent": {"type": "boolean"},
    "failureModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "approvalRequired": {"type": "boolean"}
  }
}
