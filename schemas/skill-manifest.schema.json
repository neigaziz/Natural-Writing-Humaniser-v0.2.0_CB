{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-skills-specialist/schemas/skill-manifest.schema.json",
  "title": "Agent Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "platforms", "autonomyLevel", "entrypoint", "workflows", "requiredPermissions"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string", "minLength": 20},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "autonomyLevel": {"type": "integer", "minimum": 1, "maximum": 5},
    "entrypoint": {"type": "string", "pattern": "^[^/]+\\.md$"},
    "workflows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^workflows/.+\\.md$"}},
    "requiredPermissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
